{
  "private": true,
  "workspaces": [
    "functions",
    "web"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Api run build",
    "deploy": "firebase deploy --only functions",
    "lint": "run-p 'lint:*' && yarn workspaces foreach -Api run lint",
    "lint:oxlint": "oxlint --type-aware",
    "lint:fmt": "oxfmt --check",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  },
  "devDependencies": {
    "npm-run-all-next": "^1.4.2",
    "oxlint-tsgolint": "^7.0.2004"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=4.12.0"
  },
  "packageManager": "yarn@4.18.1"
}
