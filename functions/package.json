{
  "name": "functions",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -Rf dist && tsc -p tsconfig.build.json && tsc-alias -f",
    "lint": "tsc --noEmit",
    "gen-schema": "ts-to-zod src/bitbucket-to-gchat/events/bitbucket-events.ts src/bitbucket-to-gchat/events/bitbucket-events-schema.ts",
    "logs": "firebase functions:log",
    "serve": "yarn build && firebase emulators:start --only functions",
    "start": "yarn build && firebase functions:shell",
    "test": "vitest"
  },
  "dependencies": {
    "@googleapis/chat": "^51.2.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.19.2",
    "firebase-functions-test": "^3.5.0",
    "ts-to-zod": "^5.1.0",
    "tsc-alias": "^1.9.8",
    "type-fest": "^5.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
